# ================================================================
# INSTAGRAM GRAPH API CONFIGURATION
# ================================================================
# 
# To get these credentials:
# 1. Go to https://developers.facebook.com/apps/
# 2. Create/Select your app and navigate to Settings > Basic
# 3. Use the app to connect your Instagram Business Account
# 4. Get your Long-lived Access Token from the Graph API Explorer
# 5. Find your Instagram Business Account ID
#
# NOTE: Access tokens expire - refresh periodically!
# Use Graph API to generate long-lived tokens (valid for ~60 days)
# Short-lived tokens are valid for only ~1 hour
#

INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID
